{
    "name": "metavox/metavox",
    "description": "MetaVox - Custom Metadata Fields for Nextcloud",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "doctrine/dbal": "^4.4",
        "nextcloud/ocp": "dev-stable31",
        "phpunit/phpunit": "^10.5",
        "sabre/dav": "4.7.0",
        "sabre/event": "5.1.7",
        "sabre/http": "5.1.12",
        "sabre/vobject": "4.5.6"
    },
    "autoload": {
        "psr-4": {
            "OCA\\MetaVox\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\MetaVox\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
