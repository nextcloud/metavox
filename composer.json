{
    "name": "metavox/metavox",
    "description": "MetaVox - Custom Metadata Fields for Nextcloud",
    "license": "AGPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "nextcloud/ocp": "dev-stable31",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "OCA\\MetaVox\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\MetaVox\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite unit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    }
}
