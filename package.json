{
  "name": "metavox",
  "description": "MetaVox - Custom Metadata Fields for Nextcloud",
  "version": "2.2.3",
  "author": "Sam Ditmeijer",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/check-l10n-sync.js",
    "build": "npx webpack --mode production",
    "dev": "npx webpack --mode development",
    "watch": "npx webpack --mode development --watch",
    "serve": "npx webpack serve --mode development",
    "l10n:extract": "node scripts/extract-en-json.js",
    "l10n:lint": "node scripts/lint-l10n-strings.js",
    "l10n:check": "node scripts/check-l10n-sync.js",
    "test:l10n": "node --test tests/js/",
    "l10n:generate-js": "node scripts/generate-l10n.js",
    "l10n:po": "node scripts/json-to-po.js",
    "pot": "npm run l10n:extract && node scripts/generate-pot.js",
    "l10n:push": "npm run l10n:extract && node scripts/lint-l10n-strings.js && node scripts/generate-pot.js"
  },
  "dependencies": {
    "@nextcloud/auth": "^2.5.0",
    "@nextcloud/axios": "^2.5.0",
    "@nextcloud/dialogs": "^7.2.0",
    "@nextcloud/files": "^4.0.0-rc.0",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.1.0",
    "@nextcloud/notify_push": "^1.3.1",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.0.0",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@vue/compiler-sfc": "^3.5.30",
    "babel-loader": "^9.2.1",
    "buffer": "^6.0.3",
    "css-loader": "^7.1.2",
    "sass": "^1.96.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "vue": "^3.5.27",
    "vue-loader": "^17.4.2",
    "webpack": "^5.103.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "node-forge": "^1.3.1",
    "axios": "^1.18.1",
    "dompurify": "^3.4.14"
  }
}
